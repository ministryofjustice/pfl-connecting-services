    "jsdom": "30.1.1",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "prettier-plugin-jinja-template": "2.2.0",
    "start-server-and-test": "^3.0.13",
    "supertest": "7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  }
