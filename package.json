{
  "name": "pfl-connecting-services",
  "version": "0.0.1",
  "description": "PFL Connecting Services - Help making child arrangements",
  "repository": "git@ssh.dev.azure.com:v3/ACE-C514/pfl-connecting-services/pfl-connecting-services",
  "license": "MIT",
  "scripts": {
    "build": "node esbuild/esbuild.config.mjs --build",
    "start": "node $ENV_FILE_OPTION $NODE_OPTIONS dist/app.js | bunyan -o short",
    "start:dev": "ENV_FILE_OPTION='--env-file=.env' nodemon --exec 'npm run build && npm run start'",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --max-warnings 0 --fix",
    "prettier": "prettier . --cache --check",
    "prettier:fix": "prettier . --cache --write",
    "typecheck": "tsc && tsc -p e2e-tests",
    "test": "DOTENV_CONFIG_PATH='.env.test' jest",
    "test:ci": "DOTENV_CONFIG_PATH='.env.test' jest --runInBand --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug"
  },
  "engines": {
    "node": "^26",
    "npm": "^12.0.0"
  },
  "dependencies": {
    "bunyan": "1.8.15",
    "bunyan-format": "0.2.1",
    "compression": "1.8.2",
    "connect-flash": "0.1.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "1.4.7",
    "csrf-sync": "4.2.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "1.19.0",
    "express-validator": "^7.3.2",
    "govuk-frontend": "^6.6.0",
    "helmet": "8.3.0",
    "http-errors": "2.0.1",
    "i18n": "0.15.4",
    "nocache": "4.0.0",
    "nunjucks": "3.2.4",
    "on-finished": "^2.4.2",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "brace-expansion": "^5.0.12",
    "joi": "^18.2.9",
    "js-yaml": "^4.1.2",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.0",
    "source-map-js": "^1.2.2",
    "nodemon": {
      "chokidar": "4.0.3"
    },
    "nunjucks": {
      "chokidar": "4.0.3"
    },
    "glob": {
      "minimatch": "^10.2.3"
    },
    "eslint-plugin-import": {
      "minimatch": "^3.1.4"
    },
    "eslint": {
      "minimatch": "^3.1.4"
    },
    "@eslint/eslintrc": {
      "minimatch": "^3.1.4"
    },
    "@eslint/config-array": {
      "minimatch": "^3.1.4"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@jgoz/esbuild-plugin-typecheck": "5.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@tsconfig/node26": "26.0.1",
    "@types/bunyan": "1.8.11",
    "@types/bunyan-format": "0.2.9",
    "@types/compression": "1.8.1",
    "@types/connect-flash": "0.0.40",
    "@types/cookie-parser": "1.4.10",
    "@types/express-session": "1.19.0",
    "@types/http-errors": "2.0.5",
    "@types/i18n": "0.13.12",
    "@types/jest": "30.0.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/nunjucks": "3.2.6",
    "@types/on-finished": "^2.3.5",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "18.0.4",
    "dotenv-cli": "11.0.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-manifest": "1.0.5",
    "esbuild-sass-plugin": "3.7.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "form-data": "^4.0.6",
